# Copy to .env only on the Lightsail instance and chmod 600. Never commit it.
DOMAIN=REPLACE_WITH_DNS_NAME
BACKEND_CORS_ORIGINS=https://REPLACE_WITH_DNS_NAME

POSTGRES_DB=bloodsugar
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/bloodsugar

# Staging APK authentication only. Do not use this mode for real customers.
ALLOW_DEV_AUTH=true
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_JWT_ISSUER=https://REPLACE_WITH_DNS_NAME
AUTH_JWT_AUDIENCE=bloodsugar-api

DEEPSEEK_API_KEY=REPLACE_ON_SERVER_ONLY
DEEPSEEK_MODEL_ID=deepseek-v4-flash
