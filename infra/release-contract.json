{
  "schema_version": 2,
  "api_contract_version": "1",
  "deployment_target": "infra/lightsail/compose.yml",
  "artifact_policy": {
    "build_once": true,
    "backend_and_migration_use_same_image": true,
    "record_git_sha_per_release": true
  },
  "database_policy": {
    "strategy": "expand-contract",
    "backup_before_migration": true,
    "automatic_downgrade": false,
    "contract_after_supported_clients_expire": true
  },
  "rollout_policy": {
    "strategy": "single-host-recreate",
    "readiness_path": "/readyz",
    "liveness_path": "/healthz",
    "release_identity_path": "/version",
    "minimum_observation_minutes": 15
  },
  "rollback_policy": {
    "application_first": true,
    "database_downgrade": false,
    "require_previous_git_sha": true
  }
}
