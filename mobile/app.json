{
  "expo": {
    "name": "糖錄錄",
    "slug": "bloodsugar-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bloodsugar",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bloodsugar.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "糖錄錄需要麥克風權限以便在本機轉錄語音紀錄。"
      }
    },
    "android": {
      "package": "app.bloodsugar.mobile"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "糖錄錄需要麥克風權限來將語音轉成文字。",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
