# Local Expo configuration. Email/password login is required before using the app.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_LOCAL_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_AWS_API_BASE_URL=https://api.example.com/api
EXPO_PUBLIC_ALLOW_DEV_AUTH=false
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
EXPO_PUBLIC_ENABLE_DEV_SERVER_SWITCHER=false

# Keep development header-based auth disabled. Login tokens are stored with SecureStore.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# EXPO_PUBLIC_ALLOW_DEV_AUTH=false
# EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
# EXPO_PUBLIC_ENABLE_DEV_SERVER_SWITCHER=false
